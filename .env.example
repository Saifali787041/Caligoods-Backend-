# =============================================================================
#  Caligoods Enterprise Platform - Environment Configuration
# -----------------------------------------------------------------------------
#  Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#  If any secret is ever pasted into chat/commits/screenshots, REVOKE + rotate it.
# =============================================================================

NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173

# --- JWT (generate with: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=replace_with_32b_random_hex_secret_aaaaaaaaaaaaaaaa
JWT_REFRESH_SECRET=replace_with_32b_random_hex_secret_bbbbbbbbbbbbbbbb
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
RESET_TOKEN_EXPIRES_MIN=30
VERIFY_TOKEN_EXPIRES_HOURS=24

# --- MySQL ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=caligoods
MYSQL_USER=caligoods_user
MYSQL_PASSWORD=CaligoodsLocal2026

# --- SMTP (optional in dev; if blank, emails are logged to console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Caligoods <no-reply@caligoodsinc.com>

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Zoho Inventory (used from Phase 2; server-side ONLY, never sent to frontend) ---
#  IMPORTANT: request full scopes when generating the refresh token, e.g.
#  ZohoInventory.FullAccess.all  (or granular *.ALL scopes per module)
ZOHO_CLIENT_ID=your_zoho_client_id_here
ZOHO_CLIENT_SECRET=your_zoho_client_secret_here
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token_here
ZOHO_ORGANIZATION_ID=840592741
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com


# Read live stock from ONE Zoho warehouse only (leave blank = total of all warehouses)
WAREHOUSE_NAME=NEW CASH N CARRY
# WAREHOUSE_ID=

# Zoho auth: "oauth" (default, Self Client) OR "connection" (Catalyst connection)
ZOHO_AUTH_MODE=oauth
# ZOHO_CONNECTION_NAME=inventory_api   # used only when ZOHO_AUTH_MODE=connection

# Low-stock threshold: 1..N units = Limited, above = Available (FABS-style, default 5)
LOW_STOCK_THRESHOLD=5

# Show ONLY items with "Show in Store = true" in Zoho (FABS-style). false = show all.
SHOW_IN_STORE_ONLY=false

# Run ONLY the public live inventory (no database, no login/orders). true = no DB needed.
LIVE_INVENTORY_ONLY=true
